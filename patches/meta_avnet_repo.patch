-
-sleep 2
-
-wpa_supplicant -c ./wpa_ap_actual.conf  -ip2p0 &
-
-ifconfig p2p0 $ip
-
-touch /var/lib/misc/udhcpd.leases
-udhcpd ./udhcpd.conf
