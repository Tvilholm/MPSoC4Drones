-   echo " "
-   echo "******************************************************************"
-   echo "***      ****  **      **  ****    **  ********  **********    ***"
-   echo "***     **  **  **    **   ** **   **  **            **        ***"
-   echo "***    **    **  **  **    **  **  **  *******       **        ***"
-   echo "***   **      **  ****     **   ** **  **            **        ***"
-   echo "***  **  ....  **  **      **    ****  ********      **        ***"
-   echo "***     ......                                                 ***"
-   echo "***                                                            ***"
-   echo "*** This is a simple script to run the dd and hdparm           ***"
-   echo "*** test applications to determine the maximum                 ***"
-   echo "*** maximum achievable read and write performance for          ***"
-   echo "*** SD cards and eMMC devices.                                 ***"
