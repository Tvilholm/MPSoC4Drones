-    attribute black_box : boolean;      -- for Synplicity (obsolete)
-    attribute syn_black_box : boolean;  -- for Synplicity Version 6.0
-    attribute fpga_dont_touch: string;  -- for FPGA Express
-    attribute box_type :  string;       -- for XST
-
-    ---------------------------------------------------------------------------
