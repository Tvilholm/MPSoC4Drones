-      end if;
-      
-      case spi_state is
-        --********************* IDLE State *****************
-        when IDLE =>
-            ss_n        <= not(ss_polarity);
-            xmit_load   <= '0'; 
-            i_shift_en  <= '0';
-            
-            -- look for the transition from 0 to 1 acking the DONE
-            -- however if done_ack is stale (bit 1 is a 1) do not continue
-            if i_done_ack_ary(1) = '0' and i_done_ack_ary(0) = '1'  then
