-               spi_state <= ASSERT_SSN2;
-            end if;
-            
-         --********************* ASSERT_SSN2 State *****************
-        when ASSERT_SSN2 =>
-            -- this state asserts SS_N and waits for next edge of SCK_INT
-            -- SS_N must be asserted ~1 SCK before SCK is output from chip
