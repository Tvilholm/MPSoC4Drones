-        
-        LLINE     <= PAR_DATA_LINE;
-        FRAME     <= PAR_DATA_FRAME;
-        WINDOW    <= '0'; --not yet supported                
-        
-        LLINE_r(1)       <= '0';
-        FRAME_r(1)       <= '0';
-        WINDOW_r(1)      <= '0';    
-                            
-        -- serial mode
-        resetindex          <= not en_decoder;
