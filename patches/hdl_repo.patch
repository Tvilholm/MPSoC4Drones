-    rst              => rst,
-    wr_clk           => wr_clk,
-    wr_en            => wr_en,
-    din              => demux_din, --din,
-    full             => full,
-    overflow         => open,
-    wr_rst_busy      => open,
-    rd_clk           => rd_clk,
-    rd_en            => rd_en,
