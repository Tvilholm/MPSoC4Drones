-                if (i > vec_MSB-shift_value) then
-                    vec(i) := vec(vec_MSB);
-                else
-                    vec(i) := vec(i+shift_value);
-                end if;
-            end loop;
-            --vec := vec srl shift_value;
-        end if;
-        result := vec(vec_MSB downto result_LSB);
-        return result;
-    end;
