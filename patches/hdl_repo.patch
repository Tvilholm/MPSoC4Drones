-//---------- Select PCLK MUX ---------------------------------------------------
-generate if (PCIE_LINK_SPEED != 1) 
-
-    begin : pclk_i1_bufgctrl
-    //---------- PCLK Mux ----------------------------------
-    BUFGCTRL pclk_i1
-    (
-        //---------- Input ---------------------------------
-        .CE0                        (1'd1),         
-        .CE1                        (1'd1),        
-        .I0                         (clk_125mhz),   
-        .I1                         (clk_250mhz),   
-        .IGNORE0                    (1'd0),        
-        .IGNORE1                    (1'd0),        
-        .S0                         (~pclk_sel),    
-        .S1                         ( pclk_sel),    
-        //---------- Output --------------------------------
-        .O                          (pclk_1)
-    );
-    end
