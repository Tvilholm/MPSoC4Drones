-    -- zero extend the MSB
-    function zero_ext(inp : std_logic; new_width : INTEGER)
-        return std_logic_vector
-    is
-        variable result : std_logic_vector(new_width-1 downto 0);
-    begin
-        result(0) := inp;
-        for i in new_width-1 downto 1 loop
-            result(i) := '0';
-        end loop;
-
-        return result;
-    end;
