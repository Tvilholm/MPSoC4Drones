-  reg   [89: 0]   rdat_sr;
-  reg   [ 3: 0]   cstate;
-  reg   [ 3: 0]   nstate;
-  reg   [ 9: 0]   sc;
-  reg   [ 9: 0]   sof;
-  reg   [ 9: 0]   sol;
-  reg             eof;
-  reg             eol;
-  reg             wren;
