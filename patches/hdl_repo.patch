-    end if;
-end process;
-
--- kernelselector for normal mode
-kernelselector: process(RESET, CLOCK) 
-begin                    
-    if (RESET = '1') then  
-        kernel <= '0';                               
-    elsif (CLOCK'event and CLOCK = '1') then        
