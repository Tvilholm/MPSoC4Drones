-            .QPLL_QPLLRESET                 (QPLL_QPLLRESET),
-        //---------- QPLL DRP Ports ----------------
-            .QPLL_DRPCLK                    (QPLL_DRP_CLK),
-            .QPLL_DRPADDR                   (qpll_drp_addr),
-            .QPLL_DRPEN                     (qpll_drp_en),
-            .QPLL_DRPDI                     (qpll_drp_di),
-            .QPLL_DRPWE                     (qpll_drp_we),
-            .QPLL_DRPDO                     (qpll_drp_do),
-            .QPLL_DRPRDY                    (qpll_drp_rdy)			
