- *
- * @return  Data is the data from the register.
- *
- * @note
- * C-style signature:
- * 	u32 TCM_RECEIVER_mReadReg(u32 BaseAddress, unsigned RegOffset)
- *
- */
-#define TCM_RECEIVER_mReadReg(BaseAddress, RegOffset) \
-    Xil_In32((BaseAddress) + (RegOffset))
