-        PAR_DATA_VALID_OUT  : out   std_logic;                                       
-        PAR_DATA_LINE_OUT   : out   std_logic;                                       
-        PAR_DATA_FRAME_OUT  : out   std_logic;                                       
-        PAR_DATA_WINDOW_OUT : out   std_logic                                                                                                                                                                                        
-  );
-end remapper;
