-                            else    --8 bit mode 
-                                DATA((2*i*8)+7+index*8 downto  (2*i*8)+index*8) <= DATA_BUS((i*8)+7 downto i*8);                          
-                            end if;
-                        end loop; 
-                        
-                        if (index = 0) then         
-                            LLINE_r(0)      <= LLINE;    
-                            FRAME_r(0)      <= FRAME;    
-                            WINDOW_r(0)     <= WINDOW;   
-                        end if;
-                                                                                                                                                                                                                       
-                        if (index = 1) then
-                            index <= 0;  
-                        else
-                            index <= index + 1;   
