-            tx_shift_en       <= '1';
-
-            i_recv_data4   <= rcv_data;
-            -- all 8 bits have transferred
-            if rcv_load = '1' then
-               spi_state <= ASSERT_DONE;
-               i_shift_en  <= '0';  -- disable / reset bit counter
-            else
-               i_shift_en  <= '1';  -- enable bit counter
-            end if;
-            
-        --********************* ASSERT_DONE State *****************
-        when ASSERT_DONE =>
