-        DATA_BUS            <= PAR_DATA;
-        DATA_BUS_VALID      <= (PAR_DATA_IMGVALID and WriteCfg(0)) or (PAR_DATA_BLACKVALID and WriteCfg(1));
-                                                                                                                                                  
-        case RemapMode(2 downto 0) is
-            when "000" => -- normal            
